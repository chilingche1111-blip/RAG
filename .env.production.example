RAG_KB_DIR=/app/data/knowledge_base
RAG_DOC_SOURCES_PATH=/app/data/doc_sources.json
RAG_EVAL_CASES_PATH=/app/data/evaluation/devdocs_eval_set.json
RAG_CHUNK_SIZE=520
RAG_CHUNK_OVERLAP=90
RAG_TOP_K=4
RAG_MIN_SCORE=0.08
RAG_LEXICAL_WEIGHT=0.35
RAG_SEMANTIC_WEIGHT=0.65

# Railway default deployment should prioritize fast cold start.
RAG_ENABLE_EMBEDDINGS=0
RAG_ENABLE_RERANKER=0
RAG_ENABLE_LLM=1

RAG_LLM_PROVIDER=aicanapi
RAG_LLM_MODEL=chatgpt
RAG_LLM_REASONING_EFFORT=minimal
RAG_LLM_MAX_OUTPUT_TOKENS=420
RAG_LLM_TIMEOUT_SECONDS=30
RAG_LLM_MAX_RETRIES=2
RAG_LLM_RETRY_BACKOFF_SECONDS=1.0
RAG_QUERY_LOG_SIZE=40

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
MOONSHOT_API_KEY=
SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=
MISTRAL_API_KEY=
PERPLEXITY_API_KEY=
AICANAPI_API_KEY=

RAG_EXTRA_LLM_PROVIDERS_JSON=[]
