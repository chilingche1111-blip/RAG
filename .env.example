RAG_KB_DIR=data/knowledge_base
RAG_CHUNK_SIZE=520
RAG_CHUNK_OVERLAP=90
RAG_TOP_K=4
RAG_MIN_SCORE=0.08
RAG_LEXICAL_WEIGHT=0.35
RAG_SEMANTIC_WEIGHT=0.65
RAG_ENABLE_EMBEDDINGS=1
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_ENABLE_RERANKER=1
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_RERANK_CANDIDATES=8
RAG_RERANK_WEIGHT=0.65
RAG_ENABLE_LLM=1
RAG_LLM_MODEL=gpt-5.4-mini
RAG_LLM_REASONING_EFFORT=minimal
RAG_LLM_MAX_OUTPUT_TOKENS=420
OPENAI_API_KEY=your_openai_api_key_here
